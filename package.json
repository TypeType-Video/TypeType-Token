{
  "name": "typetype-token",
  "version": "1.7.2",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --external playwright",
    "test": "bun test",
    "typecheck": "bun run typecheck:src && bun run typecheck:tests",
    "typecheck:src": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "googlevideo": "^4.1.1",
    "playwright": "^1.62.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "bun-types": "^1.3.14",
    "typescript": "~7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
