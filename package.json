{
  "name": "typetype-token",
  "version": "1.11.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --external playwright",
    "test": "bun test",
    "typecheck": "bun run typecheck:src && bun run typecheck:tests",
    "typecheck:src": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "astring": "1.9.0",
    "bgutils-js": "^4.0.3",
    "googlevideo": "^5.0.1",
    "meriyah": "7.4.0",
    "playwright": "^1.64.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "bun-types": "^1.4.4",
    "typescript": "~7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
